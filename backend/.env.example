# ==============================================================================
# Brijnidhi Backend - AWS RDS Configuration (ap-south-1 Mumbai)
# ==============================================================================

PORT=5000
NODE_ENV=development

# AWS RDS MySQL / Aurora (Instance: database-1)
# 1. From AWS RDS Console -> Databases -> 'database-1' -> 'Connectivity & security'
# 2. Copy the 'Endpoint' into DB_HOST
DB_HOST=database-1.xxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your_rds_master_password
DB_NAME=brijnidhi
DB_SSL=false
