# ==============================================================================
# Brijnidhi Backend - AWS Configuration (ap-south-1 Mumbai)
# ==============================================================================

PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. AWS RDS MySQL / Aurora (Instance: database-1)
# ------------------------------------------------------------------------------
# 1. From AWS RDS Console -> Databases -> 'database-1' -> 'Connectivity & security'
# 2. Copy the 'Endpoint' into DB_HOST
DB_HOST=database-1.xxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your_rds_master_password
DB_NAME=brijnidhi
DB_SSL=false

# ------------------------------------------------------------------------------
# 2. AWS S3 Cloud Object Storage (Hotel photos, KYC docs, Housekeeping proofs)
# ------------------------------------------------------------------------------
# 1. From AWS S3 Console -> Buckets -> Create or choose your bucket (e.g. brijnidhi-assets)
# 2. From AWS IAM Console -> Users -> Create Access Key (Programmatic access)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=brijnidhi-assets
# Optional: CloudFront CDN or custom domain (e.g. media.brijnidhi.com)
# AWS_S3_CUSTOM_DOMAIN=
