# ==============================================================================
# Brijnidhi Backend - Environment Configuration
# ==============================================================================

PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# cPanel MySQL® & phpMyAdmin Database Connection
# ------------------------------------------------------------------------------
# In cPanel:
# 1. Use 'MySQL® Database Wizard' to create your database & user (e.g., cpuser_brijnidhi).
# 2. Assign 'ALL PRIVILEGES' to the user.
# 3. If running this backend locally, open 'Remote MySQL®' in cPanel and add '%' or your IP.
# 4. Open 'phpMyAdmin' in cPanel and import 'brijnidhi_cpanel_database.sql'.
# ------------------------------------------------------------------------------

# Database Host: Use your cPanel server domain or IP address (e.g. server.yourdomain.com or 123.45.67.89), or localhost if deployed on the cPanel server
DB_HOST=localhost
DB_PORT=3306

# Database User: e.g. cpuser_brijnidhi_user
DB_USER=root

# Database Password
DB_PASSWORD=

# Database Name: e.g. cpuser_brijnidhi
DB_NAME=brijnidhi_db
