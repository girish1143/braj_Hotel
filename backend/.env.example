# ==============================================================================
# Brijnidhi Backend - Environment Configuration
# ==============================================================================

PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. MySQL® Database Configuration
# ------------------------------------------------------------------------------
# Configure your MySQL host, port, user, password, and database:
# (Supports Local MySQL, AWS RDS, DigitalOcean, cPanel, PlanetScale, etc.)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=brijnidhi
# Set to 'true' if your provider requires SSL/TLS (e.g. AWS RDS or cloud providers)
DB_SSL=false

# ------------------------------------------------------------------------------
# 2. AWS S3 Cloud Object Storage (Hotel photos, KYC docs, Housekeeping proofs)
# ------------------------------------------------------------------------------
# 1. From AWS S3 Console -> Buckets -> Create or choose your bucket (e.g. brijnidhi-assets)
# 2. From AWS IAM Console -> Users -> Create Access Key (Programmatic access)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=brijnidhi-assets
# Optional: CloudFront CDN or custom domain (e.g. media.brijnidhi.com)
# AWS_S3_CUSTOM_DOMAIN=
