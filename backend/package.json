{
  "name": "brijnidhi-backend",
  "version": "1.0.0",
  "description": "Brijnidhi - Dedicated Braj Hotel & Pilgrimage Stay API Service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test:s3": "ts-node-dev --transpile-only src/scripts/testS3.ts",
    "check:db": "ts-node-dev --transpile-only src/scripts/checkDb.ts",
    "users": "ts-node-dev --transpile-only src/scripts/listUsers.ts",
    "add-user": "ts-node-dev --transpile-only src/scripts/addUser.ts",
    "db:users": "ts-node-dev --transpile-only src/scripts/listUsers.ts",
    "db:add-user": "ts-node-dev --transpile-only src/scripts/addUser.ts"
  },
  "keywords": [
    "braj",
    "vrindavan",
    "mathura",
    "hotels",
    "pilgrimage",
    "brijnidhi"
  ],
  "author": "Brijnidhi Team",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.14.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
